# Octane's stock FrankenPHP Caddyfile (vendor/laravel/octane/src/Commands/stubs/Caddyfile, Octane 2.21.0), used via
# `octane:frankenphp --caddyfile=...` with two changes, so only the execution model differs from ../laravel:
#   - no `encode zstd br gzip` (the nginx variant has gzip off; only Next.js compresses);
#   - `num_threads` is set explicitly (FrankenPHP's default is 2x the CPUs it sees, i.e. the host's cores).
{
	{$CADDY_GLOBAL_OPTIONS}

	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS}
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			{$CADDY_SERVER_WATCH_DIRECTIVES}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$CADDY_SERVER_SERVER_NAME} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL}

		format filter {
			wrap {$CADDY_SERVER_LOGGER}
			fields {
				request>uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	route {
		root * "{$APP_PUBLIC_PATH}"

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
