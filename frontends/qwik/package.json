{
  "name": "qwik",
  "description": "Qwik City SSR variant of the feed benchmark app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "build.types": "tsc --noEmit",
    "check": "tsc --noEmit",
    "dev": "vite --mode ssr",
    "serve": "node server/entry.node-server",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.2",
    "@builder.io/qwik-city": "1.20.2",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "packageManager": "pnpm@10.8.0"
}
