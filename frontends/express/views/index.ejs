<%- include('partials/top') -%>
<form method="post" action="/actions/create" class="compose">
<textarea name="body" maxlength="500" placeholder="What's happening on the $12 server?" required rows="3"></textarea>
<div>
<% if (error) { %><span class="error"><%= error %></span><% } else { %><span class="muted">max 500 chars</span><% } %>
<button type="submit">Post</button>
</div>
</form>
<h1>Latest</h1>
<section class="feed">
<% for (const post of posts) { -%>
<%- include('partials/post', { post, link: true }) -%>
<% } -%>
</section>
<%- include('partials/bottom') -%>
