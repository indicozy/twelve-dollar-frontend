# Rendered by the nginx image's envsubst at start: ${API_UPSTREAM}, ${LISTEN_PORT}.
upstream api {
  server ${API_UPSTREAM};
  keepalive 64;
}

server {
  listen ${LISTEN_PORT} default_server;
  root /usr/share/nginx/html;
  etag on;                                  # HTML gets an ETag: a browser's revalidation is a 304

  # Hashed build assets never change.
  location /_next/static/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Every /posts/<id> is the one exported placeholder page; the browser reads the id from the URL.
  location ~ ^/posts/[0-9]+$          { try_files /posts/_.html =404; }
  location ~ ^/posts/[0-9]+\.txt$     { try_files /posts/_.txt =404; }        # client-navigation payload
  location ~ ^/posts/[0-9]+/(.+)$     { try_files /posts/_/$1 =404; }         # per-segment prefetch files

  # Same-origin API: /api/feed -> http://api/feed (writes and reads both pass through this box).
  location /api/ {
    proxy_pass http://api/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
  }

  location / {
    try_files $uri $uri.html $uri/ =404;
  }
  error_page 404 /404.html;
}
