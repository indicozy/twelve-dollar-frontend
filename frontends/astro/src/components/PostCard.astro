---
import { actions } from "astro:actions";
import type { Post } from "../lib/server/api";

interface Props {
  post: Post;
  link?: boolean;
}

const { post, link = true } = Astro.props;
const fmt = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" });
---

<article class="post" data-post-id={post.id}>
  <header>
    <span class="author">@{post.author}</span>
    <time datetime={post.created_at}>{fmt.format(new Date(post.created_at))} UTC</time>
  </header>
  <p>{post.body}</p>
  <footer>
    <form method="POST" action={actions.like}>
      <input type="hidden" name="id" value={post.id} />
      <button type="submit" class="like">♥ <span>{post.like_count}</span></button>
    </form>
    {link ? <a href={`/posts/${post.id}`}>#{post.id}</a> : <span class="muted">#{post.id}</span>}
  </footer>
</article>
